{
  "name": "stockmiles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "check": "biome check . && pnpm -r typecheck",
    "format": "biome check --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
